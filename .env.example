# ============================================================
# DocMind — MẪU BIẾN MÔI TRƯỜNG. Copy sang .env rồi điền giá trị thật:
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env đã nằm trong .gitignore — KHÔNG commit giá trị thật.
# Quy ước ${ENV_VAR:default} theo project 'horoscope' kế bên.
# ============================================================

# --- Postgres (dùng bởi service postgres trong docker-compose) ---
# Mật khẩu DB; mặc định 'docmind' cho môi trường dev cục bộ.
POSTGRES_PASSWORD=docmind

# --- api-java datasource ---
# Trong mạng docker-compose, host là tên service 'postgres', cổng nội bộ 5432.
# Chạy ngoài compose (api trên host) thì trỏ localhost:5433.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/docmind
SPRING_DATASOURCE_USERNAME=docmind
SPRING_DATASOURCE_PASSWORD=docmind

# --- Kết nối tới service parser Python ---
DOC_SERVICE_BASE_URL=http://doc-service-py:8091

# --- LLM (9Router -> Codex GPT-6 Astra) ---
# Tích hợp định tuyến qua 9Router tới Codex (mặc định bật)
NINEROUTER_ENABLED=true
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=sk-9af495182557ea7e-713jdu-0feaf415
NINEROUTER_MODEL=codex/gpt-6-astra
CODEX_RELAY_URL=http://127.0.0.1:11500/v1
CODEX_AUTH_TOKEN=
NINEROUTER_TIMEOUT_MS=60000

# --- LLM (Gemini) ---
# Nhiều key phân tách bằng dấu phẩy để round-robin.
# ĐỂ TRỐNG mặc định: chat sẽ dùng 9Router (hoặc stub nếu tắt 9Router).
GEMINI_API_KEYS=

# --- Customer Support & EvoAgentX Self-Evolution ---
DOCMIND_CUSTOMER_STORE_NAME=DocMind Store & Digital Services
DOCMIND_CUSTOMER_HOTLINE=1900-6868
DOCMIND_CUSTOMER_EMAIL=cskh@docmind.vn
DOCMIND_CUSTOMER_EVO_ENABLED=true
DOCMIND_CUSTOMER_EVO_STRATEGY=evoagentx-textgrad-mipro
DOCMIND_CUSTOMER_EVO_PERSIST=true
DOCMIND_CUSTOMER_EVO_STORAGE_PATH=data/customer-evolution-memory.json

# --- Observability / vận hành ---
# Mức log cho cả hai service: TRACE|DEBUG|INFO|WARN|ERROR
DOCMIND_LOG_LEVEL=INFO
# true = ghi artifact debug (ảnh render trang, JSON trung gian) ra đĩa.
DOCMIND_PERSIST_ARTIFACTS=false
